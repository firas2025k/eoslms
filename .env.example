NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-15

# Clerk — add your keys from dashboard.clerk.com > API keys.
# CLERK_SECRET_KEY is server only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Server-only. Paste a Viewer token from sanity.io/manage > API > Tokens.
SANITY_API_READ_TOKEN=

# Server-only. Editor (or custom write) token used by POST /api/progress.
# Never prefix with NEXT_PUBLIC_. Never import into client components.
SANITY_API_WRITE_TOKEN=

# Server-only. Shared secret for Sanity webhook → POST /api/ingest/video (signature verification).
# Generate with: openssl rand -hex 32. Set the same value in sanity.io/manage → API → Webhooks.
INGEST_WEBHOOK_SECRET=

# Sanity Context MCP — the search agent's connection (slug applies the
# sanity.agentContext document). Server only.
# Format: https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>/vertex-search
SANITY_CONTEXT_MCP_URL=

# Google Gemini — powers the search agent. Server only.
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Server-only. Resend API key for transactional email (welcome + certificate).
# Never prefix with NEXT_PUBLIC_. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Default is EOS Academy <onboarding@resend.dev> (Resend test sender).
# After verifying eosacademy.global in Resend, set e.g.:
# RESEND_FROM=EOS Academy <hello@eosacademy.global>
RESEND_FROM=

# Optional. Reply-To. Defaults to info@eosacademy.global
RESEND_REPLY_TO=

# Studio (copy the same project/dataset into studio/.env):
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production
